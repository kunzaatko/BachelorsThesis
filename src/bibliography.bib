@article{richards1997,
  title = {Electromagnetic Diffraction in Optical Systems, {{II}}. {{Structure}} of the Image Field in an Aplanatic System},
  author = {Richards, B. and Wolf, E. and Gabor, Dennis},
  date = {1997-01},
  journaltitle = {Proceedings of the Royal Society of London. Series A. Mathematical and Physical Sciences},
  volume = {253},
